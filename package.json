{
  "name": "taxi-rio-challenge",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:api": "pnpm --filter @taxi/api start:dev",
    "dev:worker": "pnpm --filter @taxi/worker dev",
    "dev:web": "pnpm --filter @taxi/web dev --host 0.0.0.0",
