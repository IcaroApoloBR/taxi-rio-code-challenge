# Local development only. Replace values for your local environment.
MYSQL_DATABASE=corridas
MYSQL_USER=corridas
MYSQL_PASSWORD=local_corridas_password
MYSQL_ROOT_PASSWORD=local_root_password
MYSQL_PORT=3306
# Host da API fora do Compose. O serviço api do Compose sobrescreve com o nome mysql.
MYSQL_HOST=127.0.0.1

REDIS_PASSWORD=local_redis_password
REDIS_PORT=6379
# Fora do Compose, a API só consulta o Redis quando REDIS_HOST existe.
# REDIS_HOST=127.0.0.1

MONGO_INITDB_DATABASE=corridas
MONGO_INITDB_ROOT_USERNAME=local_admin
MONGO_INITDB_ROOT_PASSWORD=local_mongo_password
MONGO_PORT=27017

RABBITMQ_DEFAULT_USER=local_rabbit
RABBITMQ_DEFAULT_PASS=local_rabbit_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Fora do Compose, o outbox só publica quando RABBITMQ_URL existe.
# RABBITMQ_URL=amqp://local_rabbit:local_rabbit_password@127.0.0.1:5672
# MONGO_URL=mongodb://local_admin:local_mongo_password@127.0.0.1:27017/corridas?authSource=admin

API_PORT=3000
WEB_PORT=5173
WORKER_METRICS_PORT=9101

JWT_PUBLIC_KEY_PATH=/app/keys/jwt-public.pem
JWT_PRIVATE_KEY_PATH=/app/keys/jwt-private.pem
JWT_ISSUER=taxi-rio-local
JWT_AUDIENCE=taxi-rio-api
